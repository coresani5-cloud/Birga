# Bu faylni ".env" nomi bilan nusxalang va qiymatlarni o'zingiz kiriting.
# .env hech qachon GitHub'ga yuklanmaydi (.gitignore'da).

# --- Telegram ---
# @BotFather'dan olingan bot tokeni
TELEGRAM_BOT_TOKEN=
# Faqat shu chat_id'ga xabar yuboriladi va faqat undan buyruq qabul qilinadi
TELEGRAM_CHAT_ID=

# --- Instagram (Instagram Login bilan Graph API) ---
# Uzoq muddatli (60 kunlik) access token
INSTAGRAM_ACCESS_TOKEN=
# Instagram professional akkaunt ID raqami (user_id)
INSTAGRAM_USER_ID=

# --- Cloudflare R2 (videoni vaqtincha ochiq URL'ga qo'yish uchun) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Ixtiyoriy: bucket'ning ochiq manzili (masalan https://pub-xxxx.r2.dev).
# Bo'sh qolsa, vaqtinchalik imzolangan (presigned) havola ishlatiladi.
R2_PUBLIC_BASE_URL=

# --- ElevenLabs (ixtiyoriy, config.yaml'da voice.enabled: true bo'lsa) ---
ELEVENLABS_API_KEY=
