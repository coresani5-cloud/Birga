# ===== Kotib — server sozlamalari (Render → Environment yoki .env) =====

# Ochiq manzil (Twilio imzosini tekshirish va sozlamalardagi havolalar uchun)
PUBLIC_URL=https://kotib.example.com
# Vaqt mintaqasi
TZ_NAME=Asia/Tashkent
# Doimiy baza (Supabase/Render PostgreSQL). Bo'lmasa — data/kotib.json faylida saqlanadi
DATABASE_URL=
# Panel paroli (ixtiyoriy; bo'lmasa birinchi kirishda o'rnatiladi)
ADMIN_PASSWORD=

# --- Sun'iy intellekt (tabiiy suhbat). Bittasi yetarli ---
GEMINI_API_KEY=          # bepul: https://aistudio.google.com/apikey
GROQ_API_KEY=            # bepul: https://console.groq.com
AI_API_URL=              # yoki OpenAI-mos API manzili
AI_API_KEY=
AI_MODEL=

# --- Telefon va SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1xxxxxxxxxx     # Twilio raqamingiz (SMS eslatmalar uchun)
OPERATOR_PHONE=              # operator raqami (panelda ham kiritsa bo'ladi)
SMS_CONFIRM=0                # 1 — uchrashuvdan keyin mijozga tasdiq SMS
# Ovozlar (Twilio'da o'zbekcha ovoz yo'q — standart: turkcha ovoz o'zbek matnini o'qiydi)
CALL_VOICE_UZ=Polly.Filiz
CALL_VOICE_LANG_UZ=tr-TR
CALL_STT_UZ=uz-UZ
CALL_VOICE_RU=Polly.Tatyana

# --- Telegram (egasiga xabarlar va kunlik hisobot) ---
TG_BOT_TOKEN=                # @BotFather'dan
TG_CHAT_ID=                  # panelda ham kiritsa bo'ladi
