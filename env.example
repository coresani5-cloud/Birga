# Nusxa oling: cp .env.example .env  (install.sh buni avtomatik qiladi)
PORT=3000
JWT_SECRET=                      # uzun tasodifiy satr: openssl rand -hex 32

# ================= SMS kod (barcha davlatlar) =================
# Provayderlar: console (test) | gateway (o'z Android telefoningiz) | eskiz | twilio
SMS_PROVIDER=console
# Davlatga qarab yo'naltirish (ixtiyoriy). Misol: O'zbekiston — o'z SIM, qolgan davlatlar — Twilio
# SMS_ROUTES=998:gateway,*:twilio

# 1) O'z Android telefoningiz + SIM (https://sms-gate.app ilovasi) — faqat operator tarifi
GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1
GATEWAY_USER=
GATEWAY_PASS=
# 2) Eskiz.uz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
SMS_TEXT=                        # Eskiz'da tasdiqlangan shablon, masalan: Birga kodi: {code}
# 3) Twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE=

# Firibgarlikdan himoya ("SMS pumping")
SMS_PER_PHONE_DAY=6
SMS_PER_IP_DAY=12
SMS_PER_COUNTRY_HOUR=300
SMS_BLOCKED_COUNTRIES=           # masalan: XX,YY

# ================= Qo'ng'iroqlar: TURN server =================
# O'z coturn serveringiz (install.sh o'rnatadi)
TURN_HOST=
TURN_SECRET=
# TURN_TLS_PORT=5349
# yoki tashqi TURN (masalan metered.ca)
TURN_URL=
TURN_USER=
TURN_PASS=

MAX_UPLOAD_MB=100
# DATA_DIR=/var/lib/birga/data
# UPLOAD_DIR=/var/lib/birga/uploads
# VAPID_SUBJECT=mailto:siz@domen.uz
